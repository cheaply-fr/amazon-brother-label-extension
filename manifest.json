{
  "manifest_version": 3,
  "name": "Marketplace Brother Package Label BETA",
  "version": "2.1.1",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Prints 62 mm Amazon, Octopia and Cdiscount package labels through Brother b-PAC.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://sellercentral.amazon.fr/orders-v3/order/*",
    "https://sellercentral-europe.amazon.com/orders-v3/order/*",
    "https://sellercentral.amazon.com/orders-v3/order/*",
    "https://sellercentral.amazon.ca/orders-v3/order/*",
    "https://sellercentral.amazon.com.mx/orders-v3/order/*",
    "https://sellercentral.amazon.com.br/orders-v3/order/*",
    "https://sellercentral.amazon.ie/orders-v3/order/*",
    "https://sellercentral.amazon.co.uk/orders-v3/order/*",
    "https://sellercentral.amazon.de/orders-v3/order/*",
    "https://sellercentral.amazon.es/orders-v3/order/*",
    "https://sellercentral.amazon.it/orders-v3/order/*",
    "https://sellercentral.amazon.com.be/orders-v3/order/*",
    "https://sellercentral.amazon.nl/orders-v3/order/*",
    "https://sellercentral.amazon.se/orders-v3/order/*",
    "https://sellercentral.amazon.co.za/orders-v3/order/*",
    "https://sellercentral.amazon.pl/orders-v3/order/*",
    "https://sellercentral.amazon.eg/orders-v3/order/*",
    "https://sellercentral.amazon.com.tr/orders-v3/order/*",
    "https://sellercentral.amazon.sa/orders-v3/order/*",
    "https://sellercentral.amazon.ae/orders-v3/order/*",
    "https://sellercentral.amazon.in/orders-v3/order/*",
    "https://sellercentral.amazon.sg/orders-v3/order/*",
    "https://sellercentral.amazon.com.au/orders-v3/order/*",
    "https://sellercentral.amazon.co.jp/orders-v3/order/*",
    "https://seller.octopia.com/Order/Detail/*",
    "https://chlabs-brother-label-api-1068150044836.europe-west9.run.app/shopify/brother-print*",
    "https://amazon-chronopost-direct-api-ajz3qng24a-od.a.run.app/shopify/brother-print*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Package label settings"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["bpac-sdk.js"],
      "matches": [
        "https://sellercentral.amazon.fr/*",
        "https://sellercentral-europe.amazon.com/*",
        "https://sellercentral.amazon.com/*",
        "https://sellercentral.amazon.ca/*",
        "https://sellercentral.amazon.com.mx/*",
        "https://sellercentral.amazon.com.br/*",
        "https://sellercentral.amazon.ie/*",
        "https://sellercentral.amazon.co.uk/*",
        "https://sellercentral.amazon.de/*",
        "https://sellercentral.amazon.es/*",
        "https://sellercentral.amazon.it/*",
        "https://sellercentral.amazon.com.be/*",
        "https://sellercentral.amazon.nl/*",
        "https://sellercentral.amazon.se/*",
        "https://sellercentral.amazon.co.za/*",
        "https://sellercentral.amazon.pl/*",
        "https://sellercentral.amazon.eg/*",
        "https://sellercentral.amazon.com.tr/*",
        "https://sellercentral.amazon.sa/*",
        "https://sellercentral.amazon.ae/*",
        "https://sellercentral.amazon.in/*",
        "https://sellercentral.amazon.sg/*",
        "https://sellercentral.amazon.com.au/*",
        "https://sellercentral.amazon.co.jp/*",
        "https://seller.octopia.com/*",
        "https://chlabs-brother-label-api-1068150044836.europe-west9.run.app/*",
        "https://amazon-chronopost-direct-api-ajz3qng24a-od.a.run.app/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sellercentral.amazon.fr/*",
        "https://sellercentral-europe.amazon.com/*",
        "https://sellercentral.amazon.com/*",
        "https://sellercentral.amazon.ca/*",
        "https://sellercentral.amazon.com.mx/*",
        "https://sellercentral.amazon.com.br/*",
        "https://sellercentral.amazon.ie/*",
        "https://sellercentral.amazon.co.uk/*",
        "https://sellercentral.amazon.de/*",
        "https://sellercentral.amazon.es/*",
        "https://sellercentral.amazon.it/*",
        "https://sellercentral.amazon.com.be/*",
        "https://sellercentral.amazon.nl/*",
        "https://sellercentral.amazon.se/*",
        "https://sellercentral.amazon.co.za/*",
        "https://sellercentral.amazon.pl/*",
        "https://sellercentral.amazon.eg/*",
        "https://sellercentral.amazon.com.tr/*",
        "https://sellercentral.amazon.sa/*",
        "https://sellercentral.amazon.ae/*",
        "https://sellercentral.amazon.in/*",
        "https://sellercentral.amazon.sg/*",
        "https://sellercentral.amazon.com.au/*",
        "https://sellercentral.amazon.co.jp/*",
        "https://seller.octopia.com/Order/Detail/*"
      ],
      "js": ["parser.js", "octopia-parser.js", "printer-selector.js", "route-guard.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chlabs-brother-label-api-1068150044836.europe-west9.run.app/shopify/brother-print*",
        "https://amazon-chronopost-direct-api-ajz3qng24a-od.a.run.app/shopify/brother-print*"
      ],
      "js": ["printer-selector.js", "shopify-handoff.js"],
      "run_at": "document_idle"
    }
  ]
}
